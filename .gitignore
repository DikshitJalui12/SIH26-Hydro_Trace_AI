# ==============================================================================
# HydroTrace-AI Maritime Command Platform - .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
nosetests.xml

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# OS Generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs & Databases
*.log
*.sqlite
*.sqlite3
*.db-journal

# Temporary training files & scratch data
data/train_temp/
scratch/
scratch_*.py
verify_api.py
temp/
tmp/

# Sensitive Environment Configurations (do NOT commit secrets)
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Large Raw Satellite Downloads (Preserve models and essential sample geojson)
*.zip
*.tar.gz
*.SAFE/
*.GRD
